---
import { Image } from "astro:assets";
import happyHome from "~/assets/partners/happy-home.png";
import hannsLaundry from "~/assets/partners/hanns-laundry-services.png";
import ayalaLand from "~/assets/partners/ayalaland.png";
import innovex from "~/assets/partners/innovex.png";
import icare from "~/assets/partners/icare.png";
---

<section id="partners" aria-labelledby="partners-heading" class="bg-paper py-20 lg:py-28 border-t border-rule">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    <p class="eyebrow mb-5">Our partners</p>
    <h2 id="partners-heading" class="display-lg text-navy mb-10 lg:mb-14">Working together.</h2>

    <ul class="grid md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8" role="list">
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
          <Image src={happyHome} alt="Happy Home" widths={[320, 640, 960]} sizes="(max-width: 767px) 80vw, 400px" width={480} format="webp" quality={90} class="max-h-full w-auto max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">Happy Home</p>
      </li>
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
          <Image src={ayalaLand} alt="AyalaLand" widths={[400, 600, 766]} sizes="(max-width: 767px) 80vw, 400px" width={600} format="webp" quality={90} class="max-h-full w-full max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">AyalaLand</p>
      </li>
      <li class="border border-rule bg-white">
        <a href="https://gawangdiwa.com" class="block h-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-navy group">
          <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
            <span class="gawang-wordmark">Gawang Diwa</span>
          </div>
          <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy flex justify-between items-center group-hover:text-lighthouse-deep">Gawang Diwa <span aria-hidden="true">↗</span></p>
        </a>
      </li>
      <li class="border border-rule bg-white">
        <a href="https://vendrato.com" class="block h-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-navy group">
          <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
            <span class="vendrato-wordmark"><span class="vendrato-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>vendrato</span>
          </div>
          <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy flex justify-between items-center group-hover:text-lighthouse-deep">Vendrato <span aria-hidden="true">↗</span></p>
        </a>
      </li>
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10 bg-[#ff8214]">
          <Image src={innovex} alt="Innovex Electro-Mech Corp." widths={[480, 800, 851]} sizes="(max-width: 767px) 80vw, 450px" width={600} format="webp" quality={90} class="max-h-full w-full max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">Innovex Electro-Mech Corp.</p>
      </li>
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10 bg-[#ff6d00]">
          <Image src={icare} alt="iCare" widths={[480, 800, 805]} sizes="(max-width: 767px) 80vw, 450px" width={600} format="webp" quality={90} class="max-h-full w-full max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">iCare</p>
      </li>
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
          <Image src={hannsLaundry} alt="HANN’s Laundry Services" widths={[480, 800, 1200]} sizes="(max-width: 767px) 80vw, 550px" width={600} format="webp" quality={90} class="max-h-full w-full max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">HANN’s Laundry Services</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .gawang-wordmark { font-family: "Playfair Display", Georgia, "Times New Roman", serif; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 700; letter-spacing: -.025em; color: #0d3a2b; white-space: nowrap; }
  .vendrato-wordmark { display: inline-flex; align-items: center; gap: .75rem; font-family: "Space Grotesk", sans-serif; font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 700; letter-spacing: -.045em; color: #0b0b0b; }
  .vendrato-mark { display: grid; grid-template-columns: repeat(3, .65rem); grid-template-rows: repeat(3, .65rem); gap: .12rem; flex-shrink: 0; }
  .vendrato-mark i { display: block; background: #ff5a00; }
  .vendrato-mark i:nth-child(1) { grid-column: 1; grid-row: 3; }
  .vendrato-mark i:nth-child(2) { grid-column: 2; grid-row: 2; }
  .vendrato-mark i:nth-child(3) { grid-column: 3; grid-row: 1; }
  .vendrato-mark i:nth-child(4) { grid-column: 3; grid-row: 2; opacity: .35; }
</style>
