---
import { Image } from "astro:assets";
import happyHome from "~/assets/partners/happy-home.png";
import hannsLaundry from "~/assets/partners/hanns-laundry-services.png";
---

<section id="partners" aria-labelledby="partners-heading" class="bg-paper py-20 lg:py-28 border-t border-rule">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
    <p class="eyebrow mb-5">Our partners</p>
    <h2 id="partners-heading" class="display-lg text-navy mb-10 lg:mb-14">Working together.</h2>

    <ul class="grid md:grid-cols-2 gap-6 lg:gap-8" role="list">
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
          <Image src={happyHome} alt="Happy Home" widths={[320, 640, 960]} sizes="(max-width: 767px) 80vw, 400px" width={480} format="webp" quality={90} class="max-h-full w-auto max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">Happy Home</p>
      </li>
      <li class="border border-rule bg-white">
        <div class="h-64 sm:h-72 flex items-center justify-center p-7 sm:p-10">
          <Image src={hannsLaundry} alt="HANN’s Laundry Services" widths={[480, 800, 1200]} sizes="(max-width: 767px) 80vw, 550px" width={600} format="webp" quality={90} class="max-h-full w-full max-w-full object-contain" loading="lazy" />
        </div>
        <p class="border-t border-rule px-6 py-5 font-display text-xl uppercase tracking-wide text-navy">HANN’s Laundry Services</p>
      </li>
    </ul>
  </div>
</section>
